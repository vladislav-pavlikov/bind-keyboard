# Set URL for your scoped packages.
bind-keyboard:registry=https://gitlab.com/api/v4/npm/

# Add the token for the scoped packages URL. This will allow you to download
//gitlab.com/api/v4/packages/npm/:_authToken=${NPM_TOKEN}

# Add token for uploading to the registry. Replace <your_project_id>
//gitlab.com/api/v4/projects/51485196/packages/npm/:_authToken=${NPM_TOKEN}
