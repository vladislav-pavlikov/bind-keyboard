{
  "name": "bind-keyboard",
  "version": "1.0.0",
  "description": "Lightweight Typescript library for managing keyboard event bindings and executing callback functions for specific key combinations",
  "type": "module",
  "main": "./dist/bind-keyboard.umd.cjs",
  "module": "./dist/bind-keyboard.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bind-keyboard.js",
      "require": "./dist/bind-keyboard.umd.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.umd.cjs"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "keyboard",
    "keybinding",
    "key events",
    "keyboard shortcuts",
    "keyboard events",
    "event handling",
    "key combination",
    "javascript",
    "typescript",
    "npm",
    "library"
  ],
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.13.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun-types": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-config-love": "^155.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pinst": "^3.0.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  },
  "overrides": {
    "brace-expansion": "^1.1.18",
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.4",
    "picomatch": "^2.3.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.react.config.ts",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "eslint 'src/**/*.{js,ts,jsx,tsx}' 'demo/**/*.ts' --quiet --fix",
    "prepare": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "prepublishOnly": "npm run build",
    "bundlesize": "npm run build && node scripts/check-bundle-size.mjs",
    "check-exports": "npm run build && node scripts/check-exports.mjs",
    "check-dist-behavior": "npm run build && node scripts/check-dist-behavior.mjs",
    "demo:dev": "node scripts/generate-llms-full.mjs && vite --config vite.demo.config.ts",
    "demo:build": "node scripts/generate-llms-full.mjs && tsc -p demo/tsconfig.json && vite build --config vite.demo.config.ts"
  },
  "repository": "https://gitlab.com/bind-keyboard/bind-keyboard.git",
  "homepage": "https://gitlab.com/bind-keyboard/bind-keyboard",
  "author": "Vladislav Pavlikov<https://gitlab.com/pavlikov.deal>",
  "license": "MIT",
  "bundlesize": [
    {
      "path": "./dist/bind-keyboard.js",
      "maxSize": "4 kB"
    },
    {
      "path": "./dist/bind-keyboard.umd.cjs",
      "maxSize": "4 kB"
    },
    {
      "path": "./dist/react.js",
      "maxSize": "4 kB"
    },
    {
      "path": "./dist/react.umd.cjs",
      "maxSize": "4 kB"
    }
  ]
}
